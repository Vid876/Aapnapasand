# Public application URL
NEXT_PUBLIC_SITE_URL=https://www.bohoblockprinted.com
NEXTAUTH_URL=https://www.bohoblockprinted.com
NEXTAUTH_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret

# Gmail SMTP - use a Google 16-character App Password, never the account password.
# Spaces in the copied App Password are removed automatically by the email service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bohoblockprinted1@gmail.com
SMTP_PASS=
FROM_EMAIL=bohoblockprinted1@gmail.com

# Existing project services
MONGODB_URI=replace-with-mongodb-connection-string
